<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Committee Management — Delegate Allocations Portal</title>
</head>
<style>

  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --indigo: #16112E;
    --indigo-deep: #0E0A20;
    --elizabeth: #2B1C50;
    --gold-1: #FFC06B;
    --gold-2: #BE7800;
    --central: #CD1B46;
    --circle: #FF9F00;
    --dlr: #078370;
    --hair: rgba(237,234,246,.08);
    --muted: rgba(237,234,246,.55);
    --serif: 'Butler', 'Georgia','Times New Roman', serif;
    --sans: 'Futura PT', 'Futura', 'Century Gothic', 'Trebuchet MS', sans-serif;
  }

  body {
    background: var(--indigo-deep);
    color: var(--gold-1);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
    padding-top: 118px;
  }

  button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }

  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 18px;
    padding: 14px 28px;
    background: var(--indigo);
    border-bottom: 1px solid var(--hair);
    z-index: 6;
  }
  .brand { font-weight: 700; display: flex; align-items: center; gap: 10px; }
  .brand-logo { height: 28px; width: auto; display: block; }
  .avatar-wrap { position: absolute; top: 50%; right: 28px; transform: translateY(-50%); }
  .avatar {
    width: 34px; height: 34px;
    border-radius: 50%;
    background: var(--gold-1);
    color: #1c1330;
    display: flex; align-items: center; justify-content: center;
    font-size: .75rem; font-weight: 700;
  }
  .avatar-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 190px;
    background: var(--elizabeth);
    border: 1px solid var(--hair);
    border-radius: 14px;
    padding: 8px;
    box-shadow: 0 12px 30px rgba(0,0,0,.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .15s ease, transform .15s ease;
    z-index: 20;
  }
  .avatar-menu.open { opacity: 1; visibility: visible; transform: translateY(0); }
  .avatar-menu-label { font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); padding: 6px 10px 8px; }
  .avatar-menu-item { display: block; padding: 9px 10px; border-radius: 9px; font-size: .85rem; color: var(--gold-1); text-decoration: none; }
  .avatar-menu-item:hover { background: rgba(255,255,255,.06); }

  .menu-fixed {
    position: fixed;
    top: 63px;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 28px;
    background: var(--elizabeth);
    border-bottom: 1px solid var(--hair);
    overflow-x: auto;
    z-index: 5;
  }
  .menu-fixed .side-title { margin: 0; flex-shrink: 0; white-space: nowrap; }
  .side-title { font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  .side-nav { display: flex; flex-direction: row; flex: 1; gap: 4px; min-width: 0; }
  .side-link {
    flex: 1 1 0;
    min-width: 120px;
    display: block;
    padding: 9px 12px;
    border-radius: 10px;
    color: var(--gold-1);
    font-size: .85rem;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }
  .side-link:hover { background: rgba(255,255,255,.05); }
  .side-link.on { background: var(--gold-2); color: #1c1330; font-weight: 600; }

  .layout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 28px;
  }

  .card {
    background: var(--elizabeth);
    border: 3px solid var(--hair);
    border-radius: 20px;
    padding: 20px;
  }

  .summary-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .summary-row .stat { padding: 0 6px; }
  .summary-row .stat:not(:last-child) { border-right: 1px solid var(--hair); }
  .summary-row .k { font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin-bottom: 8px; }
  .summary-row .v { font-family: Georgia, serif; font-size: 1.8rem; }

  .pill {
    display: inline-block;
    font-size: .7rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 100px;
  }
  .pill.gold { background: rgba(255,192,107,.15); color: var(--gold-1); }
  .pill.dlr  { background: rgba(7,131,112,.18);  color: #37d3b6; }
  .pill.central { background: rgba(205,27,70,.16); color: #ff6b8f; }
  .pill.circle { background: rgba(255,159,0,.16); color: var(--circle); }

  .page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .page-head h1 { font-family: var(--serif); font-weight: 400; font-size: 1.4rem; color: var(--gold-1); }
  .page-head p { font-size: .8rem; color: var(--muted); margin-top: 4px; }

  .add-btn {
    flex-shrink: 0;
    font-size: .8rem;
    font-weight: 600;
    color: #1c1330;
    background: var(--gold-2);
    padding: 9px 18px;
    border-radius: 100px;
  }
  .add-btn:hover { background: var(--gold-1); }

  .table-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 18px;
  }
  .table-search {
    flex: 1;
    min-width: 180px;
    max-width: 280px;
    background: rgba(255,255,255,.04);
    border: 1px solid var(--hair);
    border-radius: 100px;
    padding: 8px 14px;
    color: var(--gold-1);
    font-family: inherit;
    font-size: .85rem;
  }
  .table-search::placeholder { color: var(--muted); }
  .filter-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .filter-chip {
    padding: 7px 14px;
    border-radius: 100px;
    font-size: .8rem;
    color: var(--gold-1);
    background: rgba(255,255,255,.04);
    border: 1px solid var(--hair);
  }
  .filter-chip:hover { background: rgba(255,255,255,.08); }
  .filter-chip.on { background: var(--gold-2); color: #1c1330; font-weight: 600; border-color: transparent; }

  .is-hidden { display: none !important; }

  .table-wrap { overflow-x: auto; margin-top: 18px; }
  .committee-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  .committee-table th {
    text-align: left;
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--muted);
    padding: 8px 12px;
    border-bottom: 1px solid var(--hair);
    white-space: nowrap;
  }
  .committee-table td {
    padding: 12px;
    border-bottom: 1px solid var(--hair);
    color: var(--gold-1);
    vertical-align: top;
  }
  .committee-table tr:last-child td { border-bottom: none; }
  .committee-row { cursor: pointer; transition: background-color .15s ease; }
  .committee-row:hover { background: rgba(255,255,255,.03); }
  .committee-row:focus-visible { outline: 2px solid var(--gold-1); outline-offset: -2px; }

  .bento-name { font-family: var(--serif); font-weight: 400; color: var(--gold-1); line-height: 1.2; font-size: 1rem; }
  .bento-sub { display: block; font-size: .75rem; color: var(--muted); margin-top: 2px; }
  .bento-topic { font-size: .8rem; color: var(--gold-1); opacity: .85; }
  .bento-chairs { font-size: .8rem; color: var(--gold-1); }
  .chair-sub { display: block; font-size: .72rem; color: var(--muted); margin-top: 2px; }

  .capacity-bar-wrap { display: flex; align-items: center; gap: 8px; min-width: 140px; }
  .capacity-bar { flex: 1; min-width: 60px; height: 6px; border-radius: 100px; background: rgba(255,255,255,.08); overflow: hidden; }
  .capacity-bar-fill { height: 100%; background: #37d3b6; border-radius: 100px; }
  .capacity-bar-fill.full { background: #ff6b8f; }
  .capacity-label { font-size: .75rem; color: var(--muted); white-space: nowrap; }
  .table-empty { display: none; padding: 24px 0; text-align: center; color: var(--muted); font-size: .85rem; }
  .table-empty.show { display: block; }

  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(14,10,32,.72);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    z-index: 50;
    opacity: 0;
    visibility: hidden;
    transition: opacity .18s ease;
  }
  .modal-overlay.open { opacity: 1; visibility: visible; }
  .modal-window {
    background: var(--elizabeth);
    border: 1px solid var(--hair);
    border-radius: 24px;
    width: min(680px, 100%);
    max-height: 84vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 24px 60px rgba(0,0,0,.45);
    transform: translateY(12px);
    transition: transform .18s ease;
  }
  .modal-overlay.open .modal-window { transform: translateY(0); }
  .modal-header {
    padding: 22px 24px;
    border-bottom: 1px solid var(--hair);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  .modal-header h2 { font-family: var(--serif); font-weight: 400; font-size: 1.3rem; color: var(--gold-1); }
  .modal-header-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .modal-close {
    width: 30px; height: 30px;
    border-radius: 50%;
    background: rgba(255,255,255,.05);
    font-size: 1rem;
    line-height: 1;
    color: var(--gold-1);
  }
  .modal-close:hover { background: rgba(255,255,255,.1); }
  .modal-body { padding: 20px 24px; overflow-y: auto; }
  .modal-section-title { font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 20px 0 10px; }
  .seat-table { width: 100%; border-collapse: collapse; font-size: .82rem; }
  .seat-table th {
    text-align: left;
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--muted);
    padding: 6px 10px;
    border-bottom: 1px solid var(--hair);
    white-space: nowrap;
  }
  .seat-table td { padding: 9px 10px; border-bottom: 1px solid var(--hair); color: var(--gold-1); }
  .seat-table tr:last-child td { border-bottom: none; }
  .seat-table .seat-delegate-empty { color: var(--muted); }
  .seat-empty { font-size: .8rem; color: var(--muted); padding: 10px 0; }

  @media (max-width: 900px) {
    .summary-row { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 700px) {
    .table-controls { flex-direction: column; align-items: stretch; }
    .table-search { max-width: none; }
  }

  .tube-lines {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .tube-lines .stop-gold-a    { stop-color: var(--elizabeth); }
  .tube-lines .stop-gold-b    { stop-color: var(--indigo); }
  .tube-lines .stop-central-a { stop-color: var(--central); }
  .tube-lines .stop-central-b { stop-color: #ff6b8f; }
  .tube-lines .stop-circle-a  { stop-color: var(--circle); }
  .tube-lines .stop-circle-b  { stop-color: #ffcf80; }
  .tube-lines .stop-dlr-a     { stop-color: var(--dlr); }
  .tube-lines .stop-dlr-b     { stop-color: #37d3b6; }

  .tube-line {
    fill: none;
    stroke-width: 12;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: .6;
    stroke-dasharray: 2600;
    stroke-dashoffset: 2600;
    animation: tube-draw 2.4s cubic-bezier(.25,.7,.3,1) forwards;
  }
  @keyframes tube-draw {
    to { stroke-dashoffset: 0; }
  }

</style>
</head>
