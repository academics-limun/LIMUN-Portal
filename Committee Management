          <tr class="committee-row" data-status="allocation full" data-search="press corps media simulation w. sadowski">
            <td><span class="bento-name">Press Corps</span><span class="bento-sub">Specialised Committee</span></td>
            <td><span class="bento-chairs">Director<span class="chair-sub">Deputy Director</span></span></td>
            <td><span class="bento-topic">Insert topic here</span></td>
            <td>
              <div class="capacity-bar-wrap">
                <div class="capacity-bar"><div class="capacity-bar-fill full" style="width:100%"></div></div>
